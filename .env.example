# ---------------------------------------------------------------------
# Optional Django Debug Toolbar
# Install with: pip install django-debug-toolbar
# ---------------------------------------------------------------------
SHOW_DEBUGGER_TOOLBAR=False

# ---------------------------------------------------------------------
# Frontend / CORS
# Adjust these origins to match your frontend development server.
# ---------------------------------------------------------------------
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------
# Email - local development defaults to console backend.
# For SMTP, change EMAIL_BACKEND and fill in the server details.
# ---------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=behrouzyou@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True


# ---------------------------------------------------------------------
# Django Sites
# ---------------------------------------------------------------------
SITE_ID=1

# ---------------------------------------------------------------------
# Production security (only relevant when DEBUG=False)
# ---------------------------------------------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
